        "next": null
      }
    ]
  },
  {
    "id": "dlg-xuanyang-quest-offer",
    "npc": "npc-xuan-yang",
    "text": "镇东草地近来僵尸夜行。你若肯替老道取回三份尸香，便将这火球术残页相授——如今灵气枯竭，多一手防身的术法，总是好的。",
    "choices": [
      {
        "text": "好，我去去就回。",
        "next": null,
        "effects": [
          {
            "type": "quest",
            "quest": "mq-1-01",
            "state": "active"
          }
        ]
      },
      {
        "text": "容我再想想。",
        "next": null
      }
    ]
  },
